# ---------------------------------------------------------------------------
# Uber Direct credentials
# ---------------------------------------------------------------------------
# Sandbox vs production is decided by WHICH KEYS you use, not by the hostname.
# Every request goes to https://api.uber.com/v1 either way. Swap in live keys
# from the Direct Dashboard once your account is certified for production.

UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# UUID for your organisation. This is the {customer_id} path param on every
# /v1/customers/... call. For a sub-org, use its organization_id here.
UBER_CUSTOMER_ID=

# Signing key for the delivery-status / courier-update webhook, from the
# Direct Dashboard. Each webhook gets its OWN key.
UBER_WEBHOOK_SIGNING_KEY=
# Optional: separate key if you configured the refund webhook separately.
# Falls back to UBER_WEBHOOK_SIGNING_KEY when unset.
UBER_REFUND_WEBHOOK_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Mock mode
# ---------------------------------------------------------------------------
# true  -> no network calls; a simulated courier advances through the real
#          status sequence so you can drive the whole app without credentials.
# false -> talk to the real api.uber.com with the keys above.
UBER_MOCK=true
